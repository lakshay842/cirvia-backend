# Cirvia Backend API - Environment Variables
# Copy to .env and update values for your environment

NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://cirvia:cirvia_secret@localhost:5432/cirvia_db?schema=public
DIRECT_URL=postgresql://cirvia:cirvia_secret@localhost:5432/cirvia_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (minimum 32 characters)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32
JWT_ACCESS_EXPIRY=30d
JWT_REFRESH_EXPIRY=30d

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=

# Razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=

# SMTP (Gmail app password, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional display From: Cirvia <you@example.com>
MAIL_FROM=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Rate Limiting
RATE_LIMIT_AUTH=10
RATE_LIMIT_SEARCH=60
RATE_LIMIT_BOOKING=20
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_ADMIN=120
RATE_LIMIT_WINDOW_MS=60000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# SMS Provider (production)
SMS_PROVIDER_URL=

# Verification encryption (optional — falls back to JWT_SECRET)
VERIFICATION_ENCRYPTION_KEY=
