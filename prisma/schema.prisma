  mediaType  HostMediaType @map("media_type")
  storageKey String        @map("storage_key")
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")

  host HostProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([mediaType])
  @@map("host_media")
}

model HostDocument {
  id           String             @id @default(uuid()) @db.Uuid
  hostId       String             @map("host_id") @db.Uuid
  documentType HostDocumentType   @map("document_type")
  storageKey   String             @map("storage_key")
  fileName     String?            @map("file_name")
  mime         String?
  status       VerificationStatus @default(PENDING)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  host HostProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@map("host_documents")
}

model HostActivity {
  id           String   @id @default(uuid()) @db.Uuid
  hostId       String   @map("host_id") @db.Uuid
  activityType String   @map("activity_type")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  host HostProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([createdAt])
  @@map("host_activities")
}

model EventAnalytics {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @unique @map("event_id") @db.Uuid
  views      Int    @default(0)
  bookings   Int    @default(0)
  attendance Int    @default(0)
  shares     Int    @default(0)
  reviews    Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_analytics")
}

// ─── System & Integrations ─────────────────────────────────────────────────────

model ApiKey {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  apiKey    String       @unique @map("api_key")
  secret    String
  status    ApiKeyStatus @default(ACTIVE)
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("api_keys")
}

model Webhook {
  id        String        @id @default(uuid()) @db.Uuid
  url       String
  event     String
  secret    String
  status    WebhookStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  logs WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id        String   @id @default(uuid()) @db.Uuid
  webhookId String   @map("webhook_id") @db.Uuid
  payload   Json
  response  Json?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_logs")
}

model FileUpload {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  fileName   String         @map("file_name")
  url        String
  type       FileUploadType
  size       Int
  mime       String
  uploadedAt DateTime       @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("file_uploads")
}

model DeletedRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tableName    String   @map("table_name")
  recordId     String   @map("record_id") @db.Uuid
  deletedBy    String?  @map("deleted_by") @db.Uuid
  deletedAt    DateTime @default(now()) @map("deleted_at")
  restoreUntil DateTime? @map("restore_until")

  deleter User? @relation("DeletedByUser", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@map("deleted_records")
}
