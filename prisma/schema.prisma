// Cirvia Database Schema — source: DATABASE_DESIGN1-4.md, DATABASE_MASTER_PROMPT.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  BLOCKED
  EXPIRED
  RESUBMITTED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum VerificationType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PAN_CARD
  INTERNATIONAL_ID
}

enum DocumentType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PAN_CARD
  INTERNATIONAL_ID
}

