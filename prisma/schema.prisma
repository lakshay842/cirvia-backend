model Report {
  id                String         @id @default(uuid()) @db.Uuid
  reporterId        String         @map("reporter_id") @db.Uuid
  reportType        ReportType     @map("report_type")
  reportedUserId    String?        @map("reported_user_id") @db.Uuid
  reportedHostId    String?        @map("reported_host_id") @db.Uuid
  reportedEventId   String?        @map("reported_event_id") @db.Uuid
  reportedBookingId String?        @map("reported_booking_id") @db.Uuid
  reportedReviewId  String?        @map("reported_review_id") @db.Uuid
  reviewType        ReviewType?    @map("review_type")
  category          ReportCategory
  reason            String
  description       String?
  status            ReportStatus   @default(PENDING)
  priority          ReportPriority @default(MEDIUM)
  assignedTo        String?        @map("assigned_to") @db.Uuid
  resolution        String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  resolvedAt        DateTime?      @map("resolved_at")
  deletedAt         DateTime?      @map("deleted_at")

  reporter        User               @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User?              @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedHost    HostProfile?       @relation("ReportedHost", fields: [reportedHostId], references: [id], onDelete: SetNull)
  reportedEvent   Event?             @relation("ReportedEvent", fields: [reportedEventId], references: [id], onDelete: SetNull)
  reportedBooking EventBooking?      @relation("ReportedBooking", fields: [reportedBookingId], references: [id], onDelete: SetNull)
  assignee        User?              @relation("ReportAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  actions         ReportAction[]
  attachments     ReportAttachment[]

  @@index([status])
  @@index([category])
  @@index([reportType])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([reporterId, reportType, reportedUserId])
  @@index([reporterId, reportType, reportedHostId])
  @@index([reporterId, reportType, reportedEventId])
  @@index([reporterId, reportType, reportedBookingId])
  @@index([reporterId, reportType, reportedReviewId, reviewType])
  @@map("reports")
}

